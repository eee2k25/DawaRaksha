# DawaRaksh dashboard — ThingSpeak configuration (optional)
# Copy to .env and adjust. The in-app Settings panel (⚙ in the connection bar)
# can also override these at runtime; settings are stored in localStorage.
# If unset, the bundled demo channel below is used.

VITE_THINGSPEAK_CHANNEL_ID=3444984
VITE_THINGSPEAK_READ_KEY=DHSLAMWUOPOPMVVY
VITE_THINGSPEAK_WRITE_KEY=2JEC9DR8ZHUJ8T0N

# Sub-path the production bundle is served from. Leave unset for hosts that
# serve the domain root (Render, Netlify, local `npm run preview`).
# GitHub Pages builds under /DawaRaksha/ — its workflow sets this to /DawaRaksha/.
# VITE_BASE_PATH=/
